# Generates Correlated Data (Interaction-based, AR(1) dependence)
generate_dataset_2 <- function(n, p, sigma,rho) {
  if (p < 12) stop("p must be at least 12 for this signal.")

  Sigma <- outer(1:p, 1:p, function(j, k) rho^abs(j - k))
  X <- MASS::mvrnorm(n, mu = rep(0, p), Sigma = Sigma)
  colnames(X) <- paste0("X", 1:p)
  f_x <- 1.8 * sin(pi * X[, 1] * X[, 2]) +
    1.2 * (X[, 3]^2 - 1) +
    1.5 * (X[, 4] * X[, 7] - rho^3) +
    1.5 * sin(pi * X[, 8]) * sin(pi * X[, 9]) +
    1.2 * X[, 10] * X[, 11] +
    1.0 * pmax(X[, 12] - 0.5, 0)
  y <- f_x + rnorm(n, 0, sigma)
  return(list(
    X = X,
    Y = y,
    mu = f_x,
    true_vars = paste0("X", c(1, 2, 3, 4, 7, 8, 9, 10, 11, 12))
  ))
}
  set.seed(10012003)
  training_data <- generate_dataset_2(250, 75, sqrt(1),0.6)
  test_data <- generate_dataset_2(250,75, sqrt(1),0.6)
  X_train <- training_data$X
  X_test <-test_data$X
