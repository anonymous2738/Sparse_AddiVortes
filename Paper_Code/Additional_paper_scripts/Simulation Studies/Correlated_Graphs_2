friedman_plot_data <- function(fit) {
  diagnostics <- thiessen_diagnostics(fit)
  inclusion_counts <- thiessen_inclusion_counts(fit)
  dimension_histograms <- thiessen_dimension_histograms(fit)

  fit$posteriorSigma <- diagnostics$sigma^2
  fit$posteriorVariableSelection <- t(inclusion_counts)
  fit$posteriorDim <- lapply(seq_len(nrow(dimension_histograms)), function(i) {
    rep(seq_len(ncol(dimension_histograms)), times = dimension_histograms[i, ])
  })
  fit$posteriorAugmentedCounts <- t(thiessen_augmented_counts(fit))
  fit$posteriorAugmentationFailures <- if (ncol(fit$posteriorAugmentedCounts) == 0L) {
    fit$posteriorAugmentedCounts
  } else {
    fit$posteriorAugmentedCounts - fit$posteriorVariableSelection
  }
  fit$ensembleInclusionProbabilities <- colMeans(inclusion_counts > 0)
  inclusion <- fit$control$mean_params$structure$inclusion
  if (inherits(inclusion, "thiessen_dart")) {
    dart_draws <- thiessen_dart_draws(fit)
    weights <- t(dart_draws$inclusion_weight)
    fit$posteriorAlpha <- dart_draws$concentration
    fit$posteriorDirichletWeights <- weights
    fit$posteriorDirichletWeightsMean <- rowMeans(weights)
    fit$posteriorDirichletWeightsLower <- apply(
      weights, 1, quantile, probs = 0.025
    )
    fit$posteriorDirichletWeightsUpper <- apply(
      weights, 1, quantile, probs = 0.975
    )
    fit$posteriorMomentum <- t(dart_draws$momentum)
  } else {
    fit$posteriorAlpha <- numeric()
    fit$posteriorDirichletWeights <- matrix(
      numeric(), nrow = ncol(fit$x), ncol = 0
    )
    fit$posteriorDirichletWeightsMean <- numeric()
    fit$posteriorDirichletWeightsLower <- numeric()
    fit$posteriorDirichletWeightsUpper <- numeric()
    fit$posteriorMomentum <- matrix(numeric(), nrow = ncol(fit$x), ncol = 0)
  }
  fit$xCentres <- setNames(numeric(ncol(fit$x)), colnames(fit$x))
  fit
}

