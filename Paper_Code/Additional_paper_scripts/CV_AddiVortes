# ======================================================================
# THIESSEN DIRICHLET VS ADAPTIVE CROSS-VALIDATION BENCHMARK
#
# Expects `benchmark_datasets`, a named list of list(X = ..., Y = ...),
# to be available in the R session, as in Cross_Validation_Benchmark_VS.R.
# ======================================================================

library(glmnet)
library(doParallel)
library(doRNG)

results_summary_full <- data.frame(
	Dataset = character(),
	Metric = character(),
	Thiessen_Dirichlet_Score = numeric(),
	Thiessen_Adaptive_Score = numeric(),
	stringsAsFactors = FALSE
)

n_runs <- 20L
num_cores <- 20L

MCMC_ITER_CV <- 60000L
MCMC_BURNIN_CV <- 50000L
DIRICHLET_WARMUP_CV <- 5000L
MOMENTUM_SETTLE_CV <- 5000L
MOMENTUM_WINDOW_CV <- 20000L

MCMC_ITER_FINAL <- 60000L
MCMC_BURNIN_FINAL <- 50000L
DIRICHLET_WARMUP_FINAL <- 5000L
MOMENTUM_SETTLE_FINAL <- 5000L
MOMENTUM_WINDOW_FINAL <- 20000L

ADAPTIVE_CV_CHAINS <- 1L
ADAPTIVE_FINAL_CHAINS <- 5L
ADAPTIVE_FINAL_THREADS <- 5L
ADAPTIVE_BURNIN_FINAL_SMALL <- 50000L
ADAPTIVE_BURNIN_FINAL_MEDIUM <- 50000L
ADAPTIVE_BURNIN_FINAL_LARGE <- 50000L
ADAPTIVE_DRAWS <- 10000L

set.seed(142)
cl <- makeCluster(num_cores, type = "PSOCK")
registerDoParallel(cl)
registerDoRNG(seed = 09012003)

clusterEvalQ(cl, {
	Sys.setenv(
		THIESSEN_EXPERIMENTAL = "1",
		OMP_NUM_THREADS = "1",
		OPENBLAS_NUM_THREADS = "1",
		MKL_NUM_THREADS = "1",
		VECLIB_MAXIMUM_THREADS = "1"
	)
	options(mc.cores = 1L)
	devtools::load_all("/home/jd191252/thiessen/r", recompile = FALSE)
	stopifnot(core_experimental())
})

clusterExport(
	cl,
	varlist = c(
		"MCMC_ITER_CV", "MCMC_BURNIN_CV", "DIRICHLET_WARMUP_CV",
		"MOMENTUM_SETTLE_CV", "MOMENTUM_WINDOW_CV",
		"MCMC_ITER_FINAL", "MCMC_BURNIN_FINAL", "DIRICHLET_WARMUP_FINAL",
		"MOMENTUM_SETTLE_FINAL", "MOMENTUM_WINDOW_FINAL",
		"ADAPTIVE_CV_CHAINS", "ADAPTIVE_FINAL_CHAINS", "ADAPTIVE_FINAL_THREADS",
		"ADAPTIVE_BURNIN_FINAL_SMALL", "ADAPTIVE_BURNIN_FINAL_MEDIUM",
		"ADAPTIVE_BURNIN_FINAL_LARGE", "ADAPTIVE_DRAWS"
	),
	envir = environment()
)

# The base prior and structural settings are tuned with Dirichlet CV first.
structural_grid <- expand.grid(
	m = 200,
	k = c(1, 3),
	Omega = 1.5,
	LambdaRate = c(2,3, 4)
)
alpha_cases <- data.frame(
	alpha_setting = c("sparse", "medium", "non_sparse"),
	alpha = c(1, 20, 40),
	a_alpha = c(0.5, 20, 40),
	b_alpha = c(1, 1, 1)
)
nu_q_cases <- data.frame(nu = c(3, 6), q = c(0.99, 0.85))
base_grid <- merge(
	merge(structural_grid, alpha_cases, by = NULL),
	nu_q_cases,
	by = NULL
)

# Adaptive-only settings are tuned conditionally on the best Dirichlet base
# parameters. Values cover the small-to-moderate momentum range used by the
# current adaptive proposal implementation; the zero profile is plain DART.
adaptive_grid <- rbind(
	data.frame(adapt_boost = 0, adapt_penalty = 0, momentum_decay = 0),
	expand.grid(
		adapt_boost = c(0.1, 0.3, 1),
		adapt_penalty = c(0.1, 0.3, 1),
		momentum_decay = c(0.1, 0.3,0.6)
	)
)

createFolds <- function(y, k = 5L) {
	shuffled_indices <- sample(seq_along(y))
	folds <- split(
		shuffled_indices,
		cut(seq_along(shuffled_indices), breaks = k, labels = FALSE)
	)
	lapply(folds, function(test_idx) setdiff(seq_along(y), test_idx))
}

get_cv_data <- function(X, Y, train_idx) {
	X_train <- X[train_idx, , drop = FALSE]
	X_val <- X[-train_idx, , drop = FALSE]
	non_constant <- apply(X_train, 2, function(col) length(unique(col)) > 1)
	list(
		X_train = X_train[, non_constant, drop = FALSE],
		X_val = X_val[, non_constant, drop = FALSE],
		Y_train = Y[train_idx],
		Y_val = Y[-train_idx]
	)
}

thiessen_control_for <- function(params, prior, is_classification,
																 burn_in, draws, dirichlet_warmup,
																 momentum_settle = 0L, momentum_window = 1L,
																 lasso_sigma = NULL) {
	inclusion <- if (prior == "dirichlet") {
		thiessen::dart_inclusion(
			alpha = params$alpha,
			a_alpha = params$a_alpha,
			b_alpha = params$b_alpha,
			dirichlet_warmup = dirichlet_warmup
		)
	} else {
		thiessen::dart_inclusion(
			alpha = params$alpha,
			a_alpha = params$a_alpha,
			b_alpha = params$b_alpha,
			adapt_boost = params$adapt_boost,
			adapt_penalty = params$adapt_penalty,
			momentum_decay = params$momentum_decay,
			dirichlet_warmup = dirichlet_warmup,
			momentum_settle = momentum_settle,
			momentum_window = momentum_window
		)
	}
	outcome <- if (is_classification) {
		thiessen::probit_outcome()
	} else {
		thiessen::gaussian_outcome(
			nu = params$nu, q = params$q, sigma_hat = lasso_sigma
		)
	}
	thiessen::thiessen_control(
		outcome = outcome,
		mean_params = thiessen::term_params(
			tessellations = params$m,
			k = params$k,
			lambda_c = params$LambdaRate,
			structure = thiessen::structure_params(
				omega = params$Omega,
				inclusion = inclusion
			)
		),
		general_params = thiessen::general_params(
			burn_in = burn_in, draws = draws, thinning = 1
		)
	)
}

fit_thiessen_cv <- function(cv, params, prior, is_classification,
														burn_in, draws, dirichlet_warmup,
														momentum_settle = 0L, momentum_window = 1L,
														lasso_sigma = NULL, chains = 1L, threads = 1L) {
	model <- thiessen::thiessen(
		cv$X_train, cv$Y_train, xtest = cv$X_val,
		control = thiessen_control_for(
			params, prior, is_classification, burn_in, draws,
			dirichlet_warmup, momentum_settle, momentum_window, lasso_sigma
		),
		chains = chains,
		threads = threads
	)
	if (is_classification) mean(round(model) == cv$Y_val) else {
		sqrt(mean((model - cv$Y_val)^2))
	}
}

format_elapsed <- function(seconds) {
	sprintf("%02d:%02d:%05.2f", floor(seconds / 3600),
					floor((seconds %% 3600) / 60), seconds %% 60)
}

clusterExport(
	cl,
	varlist = c("createFolds", "get_cv_data", "thiessen_control_for", "fit_thiessen_cv"),
	envir = environment()
)

packages_list <- "glmnet"

for (data_name in names(benchmark_datasets)[10]) {
	cat("\nAnalysing dataset:", data_name, "\n")
	current_data <- benchmark_datasets[[data_name]]
	Y <- current_data$Y
	X <- current_data$X
	is_classification <- length(unique(na.omit(Y))) == 2L

	if (is_classification) {
		unique_vals <- sort(unique(na.omit(Y)))
		Y <- as.integer(ifelse(Y == unique_vals[2], 1L, 0L))
	}

	X <- model.matrix(~ . - 1, data = as.data.frame(X, check.names = FALSE))
	n <- nrow(X)
	adaptive_burnin <- if (n < 500L) {
		ADAPTIVE_BURNIN_FINAL_SMALL
	} else if (n < 2000L) {
		ADAPTIVE_BURNIN_FINAL_MEDIUM
	} else {
		ADAPTIVE_BURNIN_FINAL_LARGE
	}
	cat(sprintf("Task: %s; Adaptive final burn-in: %d\n",
							if (is_classification) "binary classification" else "regression",
							adaptive_burnin))

	initial_train_idx <- sample(seq_len(n), size = round(0.8 * n))
	initial_non_constant <- apply(
		X[initial_train_idx, , drop = FALSE], 2,
		function(col) length(unique(col)) > 1
	)
	X <- X[, initial_non_constant, drop = FALSE]
	X_train <- X[initial_train_idx, , drop = FALSE]
	Y_train <- Y[initial_train_idx]
	cv_folds <- createFolds(Y_train, k = 5L)
	cv_lasso_sigma <- if (!is_classification) {
		vapply(cv_folds, function(train_idx) {
			cv <- get_cv_data(X_train, Y_train, train_idx)
			lasso <- cv.glmnet(as.matrix(cv$X_train), cv$Y_train)
			sqrt(lasso$cvm[which(lasso$lambda == lasso$lambda.min)])
		}, numeric(1))
	} else {
		NULL
	}

	clusterExport(
		cl,
		varlist = c("X_train", "Y_train", "cv_folds", "cv_lasso_sigma", "is_classification"),
		envir = environment()
	)
	heavy_objects_cv <- c("benchmark_datasets", "current_data", "X", "Y", "n")

	cat(sprintf("Tuning Thiessen Dirichlet (%d combinations x 5 folds)...\n",
							nrow(base_grid)))
	pf_dirichlet <- expand.grid(param_idx = seq_len(nrow(base_grid)), fold = 1:5)
	raw_dirichlet <- foreach(
		row = seq_len(nrow(pf_dirichlet)), .combine = rbind,
		.packages = packages_list, .noexport = heavy_objects_cv,
		.options.snow = list(preschedule = FALSE)
	) %dopar% {
		i <- pf_dirichlet$param_idx[row]
		fold <- pf_dirichlet$fold[row]
		cv <- get_cv_data(X_train, Y_train, cv_folds[[fold]])
		score <- fit_thiessen_cv(
			cv, base_grid[i, , drop = FALSE], "dirichlet", is_classification,
			MCMC_BURNIN_CV, MCMC_ITER_CV - MCMC_BURNIN_CV,
			DIRICHLET_WARMUP_CV,
			lasso_sigma = if (is_classification) NULL else cv_lasso_sigma[fold],
			chains = ADAPTIVE_CV_CHAINS
		)
		data.frame(param_idx = i, fold = fold, score = score)
	}
	dirichlet_scores <- aggregate(score ~ param_idx, raw_dirichlet, mean)
	dirichlet_results <- merge(
		dirichlet_scores,
		cbind(param_idx = seq_len(nrow(base_grid)), base_grid),
		by = "param_idx"
	)
	names(dirichlet_results)[names(dirichlet_results) == "score"] <- "avg_score"
	best_params_dirichlet <- if (is_classification) {
		dirichlet_results[which.max(dirichlet_results$avg_score), ]
	} else {
		dirichlet_results[which.min(dirichlet_results$avg_score), ]
	}
	print(best_params_dirichlet)

	cat(sprintf("Tuning Thiessen Adaptive (%d adaptive profiles x 5 folds)...\n",
							nrow(adaptive_grid)))
	adaptive_base <- best_params_dirichlet[1, c(
		"m", "k", "Omega", "LambdaRate", "alpha", "a_alpha", "b_alpha",
		"nu", "q"
	)]
	adaptive_base$alpha <- 1
	adaptive_base$a_alpha <- 0.5
	adaptive_base$b_alpha <- 1
	adaptive_params_grid <- cbind(
		adaptive_base[rep(1, nrow(adaptive_grid)), , drop = FALSE],
		adaptive_grid
	)
	pf_adaptive <- expand.grid(param_idx = seq_len(nrow(adaptive_params_grid)), fold = 1:5)
	raw_adaptive <- foreach(
		row = seq_len(nrow(pf_adaptive)), .combine = rbind,
		.packages = packages_list, .noexport = heavy_objects_cv,
		.options.snow = list(preschedule = FALSE)
	) %dopar% {
		i <- pf_adaptive$param_idx[row]
		fold <- pf_adaptive$fold[row]
		cv <- get_cv_data(X_train, Y_train, cv_folds[[fold]])
		score <- fit_thiessen_cv(
			cv, adaptive_params_grid[i, , drop = FALSE], "adaptive", is_classification,
			MCMC_BURNIN_CV, MCMC_ITER_CV - MCMC_BURNIN_CV,
			DIRICHLET_WARMUP_CV,
			momentum_settle = MOMENTUM_SETTLE_CV,
			momentum_window = MOMENTUM_WINDOW_CV,
			lasso_sigma = if (is_classification) NULL else cv_lasso_sigma[fold],
			chains = ADAPTIVE_CV_CHAINS
		)
		data.frame(param_idx = i, fold = fold, score = score)
	}
	adaptive_scores <- aggregate(score ~ param_idx, raw_adaptive, mean)
	adaptive_results <- merge(
		adaptive_scores,
		cbind(param_idx = seq_len(nrow(adaptive_params_grid)), adaptive_params_grid),
		by = "param_idx"
	)
	names(adaptive_results)[names(adaptive_results) == "score"] <- "avg_score"
	best_params_adaptive <- if (is_classification) {
		adaptive_results[which.max(adaptive_results$avg_score), ]
	} else {
		adaptive_results[which.min(adaptive_results$avg_score), ]
	}
	print(best_params_adaptive)

	final_splits <- lapply(seq_len(n_runs), function(run_id) {
		sample(seq_len(n), size = round(0.8 * n))
	})
	final_sigma_estimate <- if (is_classification) NA_real_ else mean(cv_lasso_sigma)
	data_combined <- data.frame(Y = Y, X, check.names = FALSE)

	clusterExport(
		cl,
		varlist = c(
			"data_combined", "final_splits", "is_classification",
			"best_params_dirichlet", "best_params_adaptive", "adaptive_burnin",
			"final_sigma_estimate"
		),
		envir = environment()
	)
	rm(X_train, Y_train, cv_folds, cv_lasso_sigma, X, Y, current_data)
	gc()

	final_workers <- max(1L, floor(num_cores / ADAPTIVE_FINAL_THREADS))
	run_groups <- split(
		seq_len(n_runs),
		rep(seq_len(min(final_workers, n_runs)), length.out = n_runs)
	)
	heavy_objects_final <- c(
		"benchmark_datasets", "X_train", "Y_train", "cv_folds", "cv_lasso_sigma",
		"best_params_dirichlet", "best_params_adaptive", "data_combined",
		"final_splits", "is_classification", "adaptive_burnin", "final_sigma_estimate"
	)
	raw_final <- foreach(
		group_id = seq_along(run_groups), .combine = rbind,
		.packages = packages_list, .noexport = heavy_objects_final,
		.options.snow = list(preschedule = FALSE)
	) %dopar% {
		do.call(rbind, lapply(run_groups[[group_id]], function(run_id) {
			train_idx <- final_splits[[run_id]]
			train_set <- data_combined[train_idx, , drop = FALSE]
			test_set <- data_combined[-train_idx, , drop = FALSE]
			X_train <- as.matrix(train_set[, -1, drop = FALSE])
			X_test <- as.matrix(test_set[, -1, drop = FALSE])
			Y_train <- train_set$Y
			Y_test <- test_set$Y
			non_constant <- apply(X_train, 2, function(col) length(unique(col)) > 1)
			X_train <- X_train[, non_constant, drop = FALSE]
			X_test <- X_test[, non_constant, drop = FALSE]
			cv_data <- list(X_train = X_train, X_val = X_test,
											Y_train = Y_train, Y_val = Y_test)

			dirichlet_score <- fit_thiessen_cv(
				cv_data, best_params_dirichlet, "dirichlet", is_classification,
				MCMC_BURNIN_FINAL, MCMC_ITER_FINAL - MCMC_BURNIN_FINAL,
				DIRICHLET_WARMUP_FINAL,
				lasso_sigma = final_sigma_estimate,
				chains = ADAPTIVE_FINAL_CHAINS, threads = ADAPTIVE_FINAL_THREADS
			)
			adaptive_score <- fit_thiessen_cv(
				cv_data, best_params_adaptive, "adaptive", is_classification,
				adaptive_burnin, ADAPTIVE_DRAWS,
				DIRICHLET_WARMUP_FINAL,
				momentum_settle = MOMENTUM_SETTLE_FINAL,
				momentum_window = MOMENTUM_WINDOW_FINAL,
				lasso_sigma = final_sigma_estimate,
				chains = ADAPTIVE_FINAL_CHAINS, threads = ADAPTIVE_FINAL_THREADS
			)
			data.frame(
				run = run_id,
				model = c("Thiessen_Dirichlet", "Thiessen_Adaptive"),
				score = c(dirichlet_score, adaptive_score)
			)
		}))
	}

	evaluation_results <- reshape(
		raw_final, idvar = "run", timevar = "model", direction = "wide"
	)
	score_columns <- c("score.Thiessen_Dirichlet", "score.Thiessen_Adaptive")
	names(evaluation_results)[match(score_columns, names(evaluation_results))] <- c(
		"Thiessen_Dirichlet_Score", "Thiessen_Adaptive_Score"
	)

	cat(sprintf("\n--- Average %s across %d runs ---\n",
							if (is_classification) "Accuracy" else "RMSE", n_runs))
	print(colMeans(evaluation_results[, c(
		"Thiessen_Dirichlet_Score", "Thiessen_Adaptive_Score"
	)]))
	cat("--- Standard deviation across runs ---\n")
	print(sapply(evaluation_results[, c(
		"Thiessen_Dirichlet_Score", "Thiessen_Adaptive_Score"
	)], sd))

	results_summary_full <- rbind(results_summary_full, data.frame(
		Dataset = data_name,
		Metric = if (is_classification) "Accuracy" else "RMSE",
		Thiessen_Dirichlet_Score = mean(evaluation_results$Thiessen_Dirichlet_Score),
		Thiessen_Adaptive_Score = mean(evaluation_results$Thiessen_Adaptive_Score)
	))
	rm(data_combined, final_splits, raw_final, evaluation_results)
	gc()
}

stopCluster(cl)

cat("\n--- Dataset-level mean scores ---\n")
print(results_summary_full)

score_ranks <- t(vapply(seq_len(nrow(results_summary_full)), function(i) {
	scores <- unlist(results_summary_full[i, c(
		"Thiessen_Dirichlet_Score", "Thiessen_Adaptive_Score"
	)], use.names = FALSE)
	rank(if (results_summary_full$Metric[i] == "Accuracy") -scores else scores,
			 ties.method = "average")
}, numeric(2)))
colnames(score_ranks) <- c("Thiessen_Dirichlet", "Thiessen_Adaptive")
cat("\n--- Average ranks across datasets (1 = best) ---\n")
print(colMeans(score_ranks))
